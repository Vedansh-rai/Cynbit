flowchart TD
    subgraph Ingestion ["Ingestion & Preprocessing Layer"]
        A1[Multi-Channel Review Stream<br/>Google, Yelp, Trustpilot, Social] --> B1[Input Validation & Sanitization<br/>Length, Noise, Contraction Expansion]
        B1 --> B2[Linguistic & Punctuation Profiler<br/>Caps Ratio, Exclamation Intensity]
        B1 --> B3[Sublinear TF-IDF Feature Extraction<br/>Word & Char N-Grams: 1-3]
    end

    subgraph CoreML ["Machine Learning Inference Core"]
        B3 --> C1[Calibrated Sentiment Classifier<br/>Logistic Regression: Pos / Neu / Neg]
        B3 --> C2[Multi-Aspect Classification Suite<br/>6 Operational Aspect Models]
        B3 --> C3[Crisis & Escalation Risk Estimator<br/>Class-Weighted Statistical ML]
        B2 --> C3
        B1 --> C4[Deterministic Hazard Trigger Scanner<br/>Legal, Health, Fraud, Harassment]
        C4 --> C3
    end

    subgraph Triage ["Unified Decision & Triage Engine"]
        C1 --> D1[Unified Analytical Aggregator]
        C2 --> D1
        C3 --> D1
        D1 --> D2{Risk Tier >= HIGH?}
    end

    subgraph Engagement ["Guardrailed Response & Human Gating"]
        D2 -- "Yes (Score >= 0.45)" --> E1[Human-in-the-Loop Review Queue<br/>Manager Escalation & Approval Required]
        D2 -- "No (Score < 0.45)" --> E2[Routine Auto-Approvable Flow]
        
        E1 --> F1[Guardrailed Response Generator<br/>Tone Alignment & Liability Protection]
        E2 --> F1
        
        F1 --> G1{Engine Mode}
        G1 -- "Default (Offline)" --> G2[Deterministic Local Engine<br/>Zero External Cost / Instant Latency]
        G1 -- "External LLM (Optional)" --> G3[OpenAI JSON Schema Adapter<br/>Automated Fallback to Local Engine]
        
        G2 --> H1[Review Approval & Webhook Dispatch]
        G3 --> H1
    end

    subgraph Analytics ["Multi-Branch Analytics & Retraining"]
        D1 --> I1[Multi-Location Sentiment Heatmaps]
        D1 --> I2[Root-Cause Operational Diagnostics]
        E1 --> I3[Active Learning & Low-Confidence Queue]
        I3 --> I4[Continuous Model Retraining Pipeline]
    end

