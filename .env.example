# Cynbit Revio AI Opportunity - Environment Variables

# Optional External LLM Integration (OpenAI or compatible endpoint)
# If omitted or left empty, the application uses its built-in, deterministic local response engine with 0 API dependencies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
MODEL_DIR=models
DATA_DIR=data
DEFAULT_CONFIDENCE_THRESHOLD=0.65
CRISIS_RISK_THRESHOLD=0.70

